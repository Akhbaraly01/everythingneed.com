APP_NAME=EverythingNeed
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=everythingneed
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=everythingneed_

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@everythingneed.com"
MAIL_FROM_NAME="${APP_NAME}"
# Set false locally to pause verification / password-reset mail during testing
MAIL_ENABLED=true

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,172.27.80.1,localhost:8000,127.0.0.1:8000,172.27.80.1:8000

FRONTEND_URL=http://127.0.0.1:8000
FRONTEND_URLS=http://localhost:8000,http://127.0.0.1:8000,http://172.27.80.1:8000

TELESCOPE_ENABLED=false

FORCE_HTTPS=false

# Footer / store links (config/app.php)
APP_SOCIAL_FACEBOOK=
APP_SOCIAL_TWITTER=
APP_SOCIAL_INSTAGRAM=
APP_SOCIAL_LINKEDIN=
APP_SOCIAL_YOUTUBE=
APP_STORE_URL=
APP_PLAY_URL=

# AI assistant (server-side proxy only - never exposed to the browser)
AI_GATEWAY_URL=
AI_API_KEY=
AI_MODEL=

# Realtime broadcasting (Laravel Reverb).
# BROADCAST_CONNECTION stays "log" (set at the top of this file) until a
# `php artisan reverb:start` server is actually running - dispatching to a
# missing Reverb server fails order/payment flows under sync queues.
# Then flip: BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8081
REVERB_SCHEME=http

# Payments (mock|manual; mock blocked in production)
PAYMENTS_DRIVER=mock
PLATFORM_FEE_PERCENT=10

# Bill vending (mock|manual; mock blocked in production)
BILLS_DRIVER=mock

# Video consultations (jitsi default, no key required)
VIDEO_PROVIDER=jitsi
VIDEO_BASE_URL=

# Platform default currency (spec 90).
APP_CURRENCY=USD

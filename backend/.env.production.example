# Production environment template for EverythingNeed backend.
# Copy to .env on the server, fill secrets, then:
#   php artisan key:generate --force   # only if APP_KEY empty
#   php artisan migrate --force
#   php artisan db:seed --class=ProductionSeeder
#   composer run optimize-prod
# Never run DatabaseSeeder / TestUsersSeeder / LocalAccessSeeder here.

APP_NAME=EverythingNeed
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://everythingneed.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=everythingneed
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
# Prefer database queue once jobs/failed_jobs migrations are applied
QUEUE_CONNECTION=database

CACHE_STORE=file
CACHE_PREFIX=everythingneed_

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@everythingneed.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ENABLED=true

SANCTUM_STATEFUL_DOMAINS=everythingneed.com,www.everythingneed.com

FRONTEND_URL=https://everythingneed.com
FRONTEND_URLS=https://everythingneed.com,https://www.everythingneed.com

TELESCOPE_ENABLED=false

# AI assistant (server-side proxy only)
AI_GATEWAY_URL=
AI_API_KEY=
AI_MODEL=

# Realtime (Laravel Reverb)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=everythingneed.com
REVERB_PORT=443
REVERB_SCHEME=https

# Payments: mock is blocked when APP_ENV=production
PAYMENTS_DRIVER=stripe
PLATFORM_FEE_PERCENT=10

# Gateway webhook secrets (config/payments.php reads these, not services.*)
PAYMENTS_STRIPE_SECRET=
PAYMENTS_STRIPE_WEBHOOK_SECRET=
PAYMENTS_PAYSTACK_SECRET=
PAYMENTS_PAYPAL_SECRET=
PAYMENTS_PAYPAL_WEBHOOK_ID=
PAYMENTS_PAYPAL_SANDBOX=false

FORCE_HTTPS=true

# Footer / store links (config/app.php social + store_links)
APP_SOCIAL_FACEBOOK=
APP_SOCIAL_TWITTER=
APP_SOCIAL_INSTAGRAM=
APP_SOCIAL_LINKEDIN=
APP_SOCIAL_YOUTUBE=
APP_STORE_URL=
APP_PLAY_URL=

VIDEO_PROVIDER=jitsi
VIDEO_BASE_URL=
